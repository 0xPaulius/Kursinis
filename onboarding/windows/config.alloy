////////////////////////////////////////////////////////////////////
// Grafana Alloy agentas Windows kompiuteryje (įdiegia install.ps1)
//
// Skaito tris įvykių žurnalo kanalus ir siunčia į kolektoriaus šliuzą
// (config/alloy/gateway.alloy, :3500) per TLS su kliento sertifikatu (mTLS).
//
// Kolektoriaus adresą į url įrašo tools/gen-certs.sh bundle (laboratorijoje —
// lab/windows/provision.ps1); sertifikatus install.ps1 nukopijuoja į
// C:\ProgramData\Kursinis\certs.
// Žymimas job="windows" (šliuzo allowlist jį praleidžia); host, channel — etiketės.
// Likę laukai (event_id, event_data, message, levelText ...) lieka JSON eilutėje,
// kurią parsina windows_rules.py detektoriuje.
////////////////////////////////////////////////////////////////////

loki.source.windowsevent "security" {
	eventlog_name          = "Security"
	use_incoming_timestamp = true
	forward_to             = [loki.process.windows.receiver]
}

loki.source.windowsevent "sysmon" {
	eventlog_name          = "Microsoft-Windows-Sysmon/Operational"
	use_incoming_timestamp = true
	forward_to             = [loki.process.windows.receiver]
}

loki.source.windowsevent "powershell" {
	eventlog_name          = "Microsoft-Windows-PowerShell/Operational"
	use_incoming_timestamp = true
	forward_to             = [loki.process.windows.receiver]
}

loki.process "windows" {
	forward_to = [loki.write.collector.receiver]

	// Etiketėms imame tik mažo kardinalumo laukus (host, channel); JSON lieka log eilute.
	stage.json {
		expressions = {
			computer = "computer",
			channel  = "channel",
		}
	}

	stage.labels {
		values = {
			host    = "computer",
			channel = "channel",
		}
	}

	stage.static_labels {
		values = {
			job = "windows",
		}
	}
}

loki.write "collector" {
	endpoint {
		url = "https://COLLECTOR:3500/loki/api/v1/push"

		// 0 = kartoti, kol pristatoma (numatyta 10 bandymų, ~8 min., po to duomenys išmetami).
		// Senesnių nei 7 d. įrašų Loki vis tiek nepriima.
		max_backoff_retries = 0

		tls_config {
			ca_file   = "C:\\ProgramData\\Kursinis\\certs\\ca.crt"
			cert_file = "C:\\ProgramData\\Kursinis\\certs\\client.crt"
			key_file  = "C:\\ProgramData\\Kursinis\\certs\\client.key"
		}
	}
}
