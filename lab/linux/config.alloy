////////////////////////////////////////////////////////////////////
// Grafana Alloy agentas Linux endpoint'e (laboratorijos serveris/darbo vieta)
//
// Alternatyva paprastam rsyslog keliui (lab/linux/provision.sh): surenka
// turtingesnę telemetriją — auditd įrašus (EXECVE, ADD_USER, USER_AUTH) ir
// systemd journal — ir siunčia į kolektoriaus šliuzą (gateway.alloy, :3500)
// per TLS su kliento sertifikatu (mTLS).
//
// Žymimas job="linux_endpoint" (šliuzo allowlist jį praleidžia); host — etiketė.
// auditd eilutės lieka žalios (key=value), jas parsina linux_rules.py.
//
// Reikia: auditd (auditctl taisyklės EXECVE/ADD_USER stebėjimui), sertifikatų
// kataloge /etc/kursinis-certs (ca.crt, client.crt, client.key).
// Pakeiskite COLLECTOR tikru kolektoriaus adresu.
////////////////////////////////////////////////////////////////////

// --- auditd įrašai (saugumo telemetrija) ---
local.file_match "audit" {
	path_targets = [{ __path__ = "/var/log/audit/audit.log", job = "linux_endpoint", host = sys.env("HOSTNAME") }]
}

loki.source.file "audit" {
	targets    = local.file_match.audit.targets
	forward_to = [loki.write.collector.receiver]
}

// --- systemd journal (auth, sudo, servisai) ---
loki.source.journal "journal" {
	max_age    = "12h"
	labels     = { job = "linux_endpoint", host = sys.env("HOSTNAME") }
	forward_to = [loki.write.collector.receiver]
}

loki.write "collector" {
	endpoint {
		url = "https://COLLECTOR:3500/loki/api/v1/push"

		tls_config {
			ca_file   = "/etc/kursinis-certs/ca.crt"
			cert_file = "/etc/kursinis-certs/client.crt"
			key_file  = "/etc/kursinis-certs/client.key"
		}
	}
}
